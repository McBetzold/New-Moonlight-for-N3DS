+// Apollo protocol extension: ask the host to run the server command with the
+// given zero-based index in the ServerCommand list it advertised in serverinfo.
+// Returns non-zero on failure (e.g. no ENet control connection).
+int LiSendExecServerCmd(uint8_t cmdId) {
+    uint8_t payload[4] = { cmdId, 0, 0, 0 };
+
+    if (!sendMessageAndForget(packetTypes[IDX_EXEC_SERVER_CMD],
+                              sizeof(payload), payload,
+                              CTRL_CHANNEL_SERVERCTL,
+                              ENET_PACKET_FLAG_RELIABLE, false)) {
+        return LastSocketFail();
+    }
+
+    return 0;
+}
